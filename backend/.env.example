PORT=3001
NODE_ENV=development
TZ=Asia/Kolkata

# Database (Choose one option)
# Option 1: Full connection string (Supabase, Neon, etc.)
DATABASE_URL=postgresql://user:password@host:5432/reachinbox
DB_SSL=false

# Option 2: Individual parameters
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=reachinbox

# Redis (Upstash or local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Service (SMTP in production; Ethereal fallback in development)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=verified@yourdomain.com
SMTP_FROM_NAME=ReachInbox

# Google OAuth
# Get credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Session (required in production; use a random 32+ byte value)
SESSION_SECRET=replace-with-a-long-random-secret

# Razorpay (payments)
# Get keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret — set this to the same value you configure in the Razorpay
# dashboard under Settings > Webhooks, with the webhook URL pointed at
# <BACKEND_URL>/api/payment/webhook and the "payment.captured" event enabled.
# This is a backup path for confirming payments; it is optional but recommended.
RAZORPAY_WEBHOOK_SECRET=

# Metrics endpoint protection (optional — leave blank to allow open access)
METRICS_SECRET=

# Backend public URL (used for unsubscribe links + tracking pixels in emails)
BACKEND_URL=http://localhost:3001
ELASTICSEARCH_URL=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=
ADMIN_EMAILS=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3001/api/slack/callback

# Frontend (set to your deployed frontend URL in production — e.g. in Render's
# dashboard env vars, not in this file; GOOGLE_CALLBACK_URL above should be
# updated the same way for production)
FRONTEND_URL=http://localhost:5173

# Worker Configuration
WORKER_CONCURRENCY=5
EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MIN_DELAY_BETWEEN_EMAILS_MS=2000

# Logging
LOG_LEVEL=info
