PORT=3001
NODE_ENV=development
TZ=Asia/Kolkata

# Database (Choose one option)
# Option 1: Full connection string (Supabase, Neon, etc.)
DATABASE_URL=postgresql://user:password@host:5432/reachify

# Option 2: Individual parameters
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=reachify

# Redis (Upstash or local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Service (Resend recommended - 3000 emails/month free)
# Get free API key at https://resend.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here

# Alternative: Ethereal (testing only, emails not delivered)
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=your-ethereal-user
# SMTP_PASS=your-ethereal-pass

# Google OAuth
# Get credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Session (auto-generated if not provided)
SESSION_SECRET=

# Metrics endpoint protection (optional — leave blank to allow open access)
METRICS_SECRET=

# SMTP password encryption — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SMTP_ENCRYPTION_KEY=

# Backend public URL (used for unsubscribe links + tracking pixels in emails)
BACKEND_URL=http://localhost:3001

# Sender name + address (defaults to SMTP_USER if not set)
SMTP_FROM=Reachify <hello@yourdomain.com>

# Frontend
FRONTEND_URL=https://reachify-8x56.onrender.com

# Worker Configuration
WORKER_CONCURRENCY=5
EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200

# Logging
LOG_LEVEL=info

# Production (Render)
GOOGLE_CALLBACK_URL=https://reachify-8x56.onrender.com/auth/google/callback
FRONTEND_URL=https://reachify-8x56.onrender.com
